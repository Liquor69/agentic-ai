# ─── LLM Provider ────────────────────────────────────────────────────────────
# Switch provider here; config.py reads this to select the SDK
LLM_PROVIDER=anthropic          # options: anthropic | openai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# ─── Model Tiers ─────────────────────────────────────────────────────────────
# "fast" tier  → classification and routing (low cost)
# "standard" tier → reasoning and response generation
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_STANDARD=claude-sonnet-4-6

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup required)
DATABASE_URL=sqlite:///./agent.db

# PostgreSQL (swap in for production — requires psycopg2 or asyncpg)
# DATABASE_URL=postgresql://user:password@localhost:5432/agent

# ─── Domain Pack ─────────────────────────────────────────────────────────────
# Selects which tool set and routing rules are active.
# Each domain is declared in domains/<name>.py and tools/<name>.py.
# Adding a domain: create those two files — zero core changes required.
DOMAIN_PACK=customer_ops        # options: customer_ops | it_helpdesk

# ─── Agent Behaviour ──────────────────────────────────────────────────────────
MAX_ITERATIONS=5                # halting condition: max planning loops before escalation
SESSION_TTL_SECONDS=3600        # how long conversation history is retained
CACHE_TTL_SECONDS=300           # Anthropic prompt cache TTL (5 min)
CONFIRMATION_TTL_SECONDS=600    # pending-confirmation TTL (10 min); blank = accept default

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Static API key for X-API-Key header. Leave blank to disable auth (dev only).
API_KEY=

# ─── External Integrations ────────────────────────────────────────────────────
# n8n webhook base URL (used by tools/webhooks.py)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook

# External billing / data API (used by tools/external_api.py)
# Leave blank to run in demo mode (mock payment history returned without a real call)
EXTERNAL_API_BASE_URL=
EXTERNAL_API_TOKEN=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development             # development | production
LOG_LEVEL=INFO
